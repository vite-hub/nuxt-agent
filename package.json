{
  "name": "nuxt-agent",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1 --port 3027",
    "nuxt:dev": "vitehub agent dev --url http://127.0.0.1:3027 --agent nuxt --input @server/agents/nuxt/dev.payload.json",
    "preview": "nitro preview",
    "slides:build": "slidev build slides/slides.md --base /presentation/ --out ../public/presentation",
    "slides:dev": "slidev slides/slides.md --port 3030",
    "typecheck": "vitehub types prepare && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.88",
    "@vite-hub/agent": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/agent@703de08",
    "@vite-hub/env": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/env@703de08",
    "@vite-hub/gateways": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/gateways@703de08",
    "@vite-hub/markdown-template": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/markdown-template@703de08",
    "@vite-hub/rate-limit": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/rate-limit@703de08",
    "@vite-hub/workspace": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/workspace@703de08",
    "drizzle-orm": "1.0.0-rc.5",
    "h3": "2.0.8",
    "nitro": "3.0.261103-rc",
    "vite-hub": "https://pkg.pr.new/vite-hub/vitehub/vite-hub@703de08"
  },
  "devDependencies": {
    "@nuxt/ui": "4.8.2",
    "@slidev/cli": "52.16.0",
    "@types/node": "^25.9.2",
    "shiki": "4.3.1",
    "tailwindcss": "4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
