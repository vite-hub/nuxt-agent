{
  "name": "nuxt-agent",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1 --port 3027",
    "logs": "node scripts/tail-vercel-logs.mjs",
    "logs:raw": "vercel logs nuxt-agent-two.vercel.app --json",
    "postbuild": "node scripts/prepare-vercel-output.mjs",
    "preview": "nitro preview",
    "typecheck": "nitro prepare && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.46",
    "@ai-sdk/openai": "^3.0.69",
    "@chat-adapter/telegram": "^4.30.0",
    "@vercel/functions": "^3.7.0",
    "@vite-hub/agent": "https://pkg.pr.new/@vite-hub/agent@9074381",
    "@vite-hub/source": "https://pkg.pr.new/@vite-hub/source@9074381",
    "@vite-hub/workflow": "https://pkg.pr.new/@vite-hub/workflow@9074381",
    "@vite-hub/workspace": "https://pkg.pr.new/@vite-hub/workspace@9074381",
    "ai": "^6.0.199",
    "chat": "^4.30.0",
    "evlog": "^2.18.1",
    "h3": "2.0.1-rc.22",
    "workflow": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "nitro": "3.0.260603-beta",
    "std-env": "^4.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
